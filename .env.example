# ─── Discord application ────────────────────────────────────────────
# Create an application at https://discord.com/developers/applications,
# then add a bot user. Copy its token + client ID below.
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id

# Test server (guild) ID — slash commands deploy here instantly during dev.
# Leave empty to deploy globally (takes up to ~1 hour to propagate).
GUILD_ID=your-test-guild-id

# ─── Welcome system (optional) ──────────────────────────────────────
# Role pinged in the welcome message + the channel it gets sent to.
# Leave blank to disable the ping behaviour entirely.
# Toggle the ping at runtime in Discord with `/welcomeping enable|disable`.
WELCOME_PING_ROLE_ID=
WELCOME_PING_CHANNEL_ID=
